{
  "@id": "https://w3id.org/krown/benchmark-integration/bsbm-smoke",
  "name": "BSBM Explore 1K RDF experiment matrix",
  "description": "Prepare the external BSBM smoke workload and execute its benchmark-owned experiment declaration through the generic RDF matrix resource.",
  "steps": [
    {
      "@id": "https://w3id.org/krown/benchmark-integration/bsbm-smoke/prepare",
      "name": "Prepare BSBM smoke manifest",
      "resource": "RdfManifestResource",
      "command": "execute",
      "parameters": {
        "benchmark": "bsbm",
        "output_file": "manifests/bsbm.json",
        "workload": "bsbm-explore-smoke",
        "dataset": "explore-1k",
        "benchmark_root": "/users/u0182905/benchmarks",
        "input_env": "KROWN_BSBM_QUERY_STREAM",
        "input_option": "--query-stream",
        "environment_options": {
          "--generation-receipt": "KROWN_BSBM_GENERATION_RECEIPT",
          "--dataset-path": "KROWN_RDF_DATASET_FILE"
        },
        "adapter_options": {
          "--selection": "smoke"
        }
      }
    },
    {
      "@id": "https://w3id.org/krown/benchmark-integration/bsbm-smoke/preflight-matrix",
      "name": "Preflight BSBM RDF experiment matrix",
      "resource": "RdfExperimentMatrixResource",
      "command": "preflight",
      "parameters": {
        "declaration_file": "/users/u0182905/benchmarks/BSBM/experiments/explore-1k-smoke.json",
        "manifest_file": "manifests/bsbm.json",
        "output_file": "raw/bsbm-matrix-preflight.json",
        "adapter_option_env": {
          "qlever/default": {
            "image": "KROWN_QLEVER_IMAGE",
            "index_command": "KROWN_QLEVER_INDEX_COMMAND",
            "server_command": "KROWN_QLEVER_SERVER_COMMAND"
          }
        }
      }
    },
    {
      "@id": "https://w3id.org/krown/benchmark-integration/bsbm-smoke/execute-matrix",
      "name": "Execute BSBM RDF experiment matrix",
      "resource": "RdfExperimentMatrixResource",
      "command": "execute",
      "parameters": {
        "declaration_file": "/users/u0182905/benchmarks/BSBM/experiments/explore-1k-smoke.json",
        "manifest_file": "manifests/bsbm.json",
        "results_file": "raw/bsbm-matrix-summary.json",
        "output_file": "raw/bsbm-matrix-results.tar.gz",
        "adapter_option_env": {
          "qlever/default": {
            "image": "KROWN_QLEVER_IMAGE",
            "index_command": "KROWN_QLEVER_INDEX_COMMAND",
            "server_command": "KROWN_QLEVER_SERVER_COMMAND"
          }
        }
      }
    }
  ]
}
