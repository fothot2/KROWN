    def test_rdflib_adapter_consumes_complete_result(self):
        class FakeResult:
            def __init__(self):
                self.consumed = 0

            def __iter__(self):
                for value in range(3):
                    self.consumed += 1
                    yield value

        class FakeGraph:
            def __init__(self):
                self.result = FakeResult()
                self.closed = False

            def query(self, query):
                return self.result

            def close(self):
                self.closed = True

        adapter = _RdfLibAdapter('cottas', '/tmp/unused', 'unused')
        graph = FakeGraph()
        adapter._graph = graph

        outcome = adapter.execute('SELECT * WHERE { ?s ?p ?o }')
        adapter.close()

        self.assertEqual(outcome.result_count, 3)
        self.assertEqual(graph.result.consumed, 3)
        self.assertTrue(graph.closed)

