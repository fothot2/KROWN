    def test_sparql_select_fingerprint_keeps_duplicates(self):
        from rdflib import Literal, Variable

        class Result:
            type = 'SELECT'
            vars = [Variable('x')]

        rows = [(Literal('a'),), (Literal('a'),), (Literal('b'),)]
        first = normalize_materialized_result(
            Result(), rows, 'SELECT ?x WHERE { ?s ?p ?x }'
        )
        second = normalize_materialized_result(
            Result(), list(reversed(rows)),
            'SELECT ?x WHERE { ?s ?p ?x }'
        )
        without_duplicate = normalize_materialized_result(
            Result(), rows[1:], 'SELECT ?x WHERE { ?s ?p ?x }'
        )

        self.assertEqual(
            first['result_fingerprint'], second['result_fingerprint']
        )
        self.assertNotEqual(
            first['result_fingerprint'],
            without_duplicate['result_fingerprint'],
        )

