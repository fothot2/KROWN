    def test_query_benchmark_writes_complete_attempts(self):
        class FakeAdapter(_RdfQueryAdapter):
            opens = 0
            closes = 0

            def open(self):
                type(self).opens += 1

            def execute(self, query):
                return _QueryOutcome(
                    result_count=0 if 'LIMIT 0' in query else 3
                )

            def close(self):
                type(self).closes += 1

        with tempfile.TemporaryDirectory() as directory:
            manifest = _load_query_manifest(
                self._write_query_manifest(directory)
            )
            output = os.path.join(directory, 'raw.jsonl')
            benchmark = _RdfQueryBenchmark(
                adapter_factory=FakeAdapter,
                experiment_id='smoke',
                system='fake',
                manifest=manifest,
                warmup_runs=1,
                measured_runs=2,
                lifecycle='shared',
            )

            records = benchmark.run(output)

            self.assertEqual(len(records), 6)
            self.assertEqual(FakeAdapter.opens, 1)
            self.assertEqual(FakeAdapter.closes, 1)
            self.assertTrue(all(row['status'] == 'ok' for row in records))
            self.assertTrue(all(row['elapsed_ns'] >= 0 for row in records))
            zero_rows = [
                row for row in records if row['query_id'] == 'q2'
            ]
            self.assertTrue(all(row['result_count'] == 0 for row in zero_rows))
            with open(output, 'r', encoding='utf-8') as stream:
                persisted = [json.loads(line) for line in stream]
            self.assertEqual(len(persisted), 6)
            self.assertNotIn('_traceback', persisted[0])

