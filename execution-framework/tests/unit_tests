    def test_executor_retains_may_fail_step_failure(self):
        class FakeResource:
            def __init__(self, data_path, config_dir, log_dir, verbose):
                pass

            def execute(self, succeed):
                return succeed

            def stop(self):
                pass

        class FakeCollector:
            def __init__(self, *args, **kwargs):
                pass

            def next_step(self):
                pass

            def stop(self):
                pass

        with tempfile.TemporaryDirectory() as directory:
            with open(os.path.join(directory, 'log.txt'),
                      'w', encoding='utf-8'):
                pass

            executor = Executor.__new__(Executor)
            executor._class_module_mapping = {
                'FakeResource': SimpleNamespace(
                    FakeResource=FakeResource
                )
            }
            executor._verbose = False
            executor._logger = MagicMock()
            executor._progress_cb = MagicMock()
            executor.clean = MagicMock(return_value=True)

            case = {
                'directory': directory,
                'data': {
                    'name': 'cumulative-status',
                    'steps': [
                        {
                            'name': 'expected failure',
                            'resource': 'FakeResource',
                            'command': 'execute',
                            'parameters': {'succeed': False},
                            'may_fail': True,
                        },
                        {
                            'name': 'later success',
                            'resource': 'FakeResource',
                            'command': 'execute',
                            'parameters': {'succeed': True},
                        },
                    ],
                },
            }

            with patch('bench_executor.executor.Collector', FakeCollector), \
                    patch('bench_executor.executor.sleep'):
                success = executor.run(
                    case, interval=0.1, run=2, checkpoint=True
                )

            self.assertFalse(success)
            self.assertFalse(os.path.exists(os.path.join(
                directory, 'results', 'run_2', '.done'
            )))
            self.assertFalse(os.path.exists(os.path.join(
                directory, '.done'
            )))
            self.assertEqual(executor._progress_cb.call_count, 4)
            executor._progress_cb.assert_any_call(
                'FakeResource', 'expected failure', False
            )
            executor._progress_cb.assert_any_call(
                'FakeResource', 'later success', True
            )

