    def test_query_features_classify_comparison_modes(self):
        cases = [
            (
                'SELECT ?s WHERE { ?s ?p ?o }',
                'select', False, False, False,
                'unordered_multiset_fingerprint',
            ),
            (
                'SELECT ?s WHERE { ?s ?p ?o } ORDER BY ?s LIMIT 5',
                'select', True, True, False,
                'ordered_fingerprint',
            ),
            (
                'SELECT ?s WHERE { ?s ?p ?o } LIMIT 5',
                'select', False, True, False,
                'count_only_nondeterministic_limit',
            ),
            (
                'SELECT ?s WHERE { ?s ?p ?o } OFFSET 2',
                'select', False, False, True,
                'unordered_multiset_fingerprint',
            ),
            (
                'ASK { ?s ?p ?o }',
                'ask', False, False, False,
                'boolean',
            ),
        ]

        for query, result_type, ordered, limited, offset, mode in cases:
            with self.subTest(query=query):
                features = classify_query(query)
                metadata = comparison_metadata(features, False)
                self.assertEqual(features.result_type, result_type)
                self.assertEqual(features.has_order_by, ordered)
                self.assertEqual(features.has_limit, limited)
                self.assertEqual(features.has_offset, offset)
                self.assertEqual(metadata['comparison_mode'], mode)

