    def test_fuseki_stop_recovers_ownership_after_container_stop(self):
        fuseki = Fuseki.__new__(Fuseki)
        fuseki._logger = MagicMock()
        fuseki._data_path = '/tmp/case/data'
        calls = []

        def stop_container(instance):
            calls.append('stop')
            return True

        def cleanup_data(data_path):
            calls.append(('cleanup', data_path))
            return True

        with patch('bench_executor.fuseki.requests.post') as post, \
                patch.object(Container, 'stop', stop_container), \
                patch.object(
                    Fuseki, 'cleanup_data', staticmethod(cleanup_data)
                ):
            post.return_value.text = ''
            post.return_value.raise_for_status.return_value = None
            success = fuseki.stop()

        self.assertTrue(success)
        self.assertEqual(calls, [
            'stop',
            ('cleanup', '/tmp/case/data'),
        ])

