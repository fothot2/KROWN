    def test_sparql_json_matches_rdflib_fingerprint(self):
        from rdflib import Literal, URIRef, Variable

        class Result:
            type = 'SELECT'
            vars = [Variable('p'), Variable('o')]

        query = 'SELECT ?p ?o WHERE { ?s ?p ?o } ORDER BY ?p ?o'
        rows = [
            (URIRef('http://example.org/name'), Literal('Alice', lang='en')),
            (URIRef('http://example.org/age'), Literal(42)),
        ]
        rdflib_result = normalize_materialized_result(Result(), rows, query)
        http_result = normalize_sparql_json_result({
            'head': {'vars': ['p', 'o']},
            'results': {'bindings': [
                {
                    'p': {'type': 'uri', 'value': 'http://example.org/name'},
                    'o': {
                        'type': 'literal', 'value': 'Alice',
                        'xml:lang': 'en',
                    },
                },
                {
                    'p': {'type': 'uri', 'value': 'http://example.org/age'},
                    'o': {
                        'type': 'literal', 'value': '42',
                        'datatype': (
                            'http://www.w3.org/2001/XMLSchema#integer'
                        ),
                    },
                },
            ]},
        }, query)

        self.assertEqual(
            rdflib_result['result_fingerprint'],
            http_result['result_fingerprint'],
        )

