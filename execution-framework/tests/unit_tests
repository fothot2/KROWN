    def test_sparql_http_adapter_times_complete_response(self):
        class FakeResponse:
            status_code = 200
            content = b'{"head":{"vars":["x"]},"results":{"bindings":[]}}'
            headers = {'Content-Type': 'application/sparql-results+json'}

            def raise_for_status(self):
                pass

            def json(self):
                return {
                    'head': {'vars': ['x']},
                    'results': {'bindings': []},
                }

        session = MagicMock()
        session.post.return_value = FakeResponse()
        adapter = _SparqlHttpAdapter(
            endpoint='http://example.test/sparql',
            timeout_s=1.0,
            correctness_mode='full',
        )
        adapter._session = session

        outcome = adapter.execute('SELECT ?x WHERE { ?x ?p ?o }')

        self.assertEqual(outcome.result_count, 0)
        self.assertIsNotNone(outcome.result_fingerprint)
