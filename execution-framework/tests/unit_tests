    def test_rdflib_worker_reports_hard_timeout(self):
        class FakeConnection:
            def __init__(self):
                self.sent = []
                self.closed = False

            def send(self, message):
                self.sent.append(message)

            def poll(self, timeout):
                return False

            def close(self):
                self.closed = True

        class FakeProcess:
            pid = 12345
            exitcode = None

            def is_alive(self):
                return True

            def join(self, timeout=None):
                pass

        adapter = _WorkerRdfLibAdapter(
            engine='vortex',
            artifact_path='/tmp/data.vortex',
            vortex_layout='cottas-native-ids',
            timeout_s=0.01,
            startup_timeout_s=1.0,
            kill_grace_s=0.0,
        )
        connection = FakeConnection()
        process = FakeProcess()
        adapter._connection = connection
        adapter._process = process

        with patch(
                'bench_executor.rdflib_query_benchmark.'
                '_terminate_process_tree') as terminate:
            with self.assertRaisesRegex(_QueryTimeoutError, '0.01s'):
                adapter.execute('SELECT * WHERE { ?s ?p ?o }')

        terminate.assert_called_once_with(12345, 0.0)
        self.assertIsNone(adapter._connection)
        self.assertIsNone(adapter._process)
        self.assertTrue(connection.closed)

