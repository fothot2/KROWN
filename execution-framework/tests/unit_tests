    def test_fuseki_cleanup_data_restores_host_ownership(self):
        with tempfile.TemporaryDirectory() as directory:
            database = os.path.join(directory, 'fuseki')
            os.makedirs(database)

            with patch('bench_executor.fuseki.subprocess.run') as run:
