    def test_logger_replacement_closes_old_handlers(self):
        with tempfile.TemporaryDirectory() as first_directory, \
                tempfile.TemporaryDirectory() as second_directory:
            first = Logger('logger-replacement-test', first_directory, False)
            first_handlers = list(first._logger.handlers)
            second = Logger(
                'logger-replacement-test', second_directory, False
            )
            file_handlers = [
                handler for handler in first_handlers
                if isinstance(handler, logging.FileHandler)
            ]
            self.assertEqual(len(file_handlers), 1)
            self.assertIsNone(file_handlers[0].stream)
            self.assertNotIn(file_handlers[0], second._logger.handlers)
            self.assertTrue(second._logger.handlers)
            second.close()

    def test_logger_close_is_idempotent(self):
        with tempfile.TemporaryDirectory() as directory:
            logger = Logger('logger-close-test', directory, False)
            logger.close()
            logger.close()
            self.assertEqual(logger._logger.handlers, [])

